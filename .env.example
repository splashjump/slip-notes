# ============================================
# 纸筏 环境变量模板 — 复制为 .env 后填写
# .env 已被 .gitignore 排除，绝不提交真实值
# ============================================

# ----- 阿里云 ECS（同步中枢）-----
SSH_KEY_PATH=~/.ssh/id_slip
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=

# ----- 端口约定（高位）-----
# 同步服务器：公网监听 50000（安全组需放行）
SLIP_SERVER_PORT=50000
# Win 本地便签服务：仅绑定 127.0.0.1，AI 用 local API
SLIP_LOCAL_PORT=60000

# ----- 同步服务器 token（部署时自动生成并回存；服务器 /opt/slip/.env 为权威副本）-----
# 格式：actor → token 的 JSON；四个角色：win1 / win2 / android / ai（AI 专用）
SLIP_TOKENS={"win1":"<64位随机hex>","win2":"<64位随机hex>","android":"<64位随机hex>","ai":"<64位随机hex>"}
# 各端单独取用（Win 客户端 / 安卓 / AI skill）
SLIP_TOKEN_WIN1=
SLIP_TOKEN_WIN2=
SLIP_TOKEN_ANDROID=
SLIP_TOKEN_AI=
