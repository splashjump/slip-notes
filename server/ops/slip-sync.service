# ============================================
# 纸筏同步服务器（slip-sync）— systemd 单元
# 托管 Docker 容器：镜像 slip-sync:latest，容器名 slip-sync
# 数据卷 /opt/slip/data（SQLite + 备份），配置 /opt/slip/.env
# 安装：cp ops/slip-sync.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now slip-sync
# ============================================
[Unit]
Description=纸筏同步服务器（slip-sync, Docker 容器）
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
# 容器不存在时创建（用 container inspect 防止误匹配同名镜像；数据卷与 env-file 需已就位，见 ops/server-install.sh）
ExecStartPre=/bin/sh -c 'docker container inspect slip-sync >/dev/null 2>&1 || docker create --name slip-sync --restart unless-stopped --env-file /opt/slip/.env -p 50000:50000 -v /opt/slip/data:/app/data slip-sync:latest'
ExecStart=/usr/bin/docker start -a slip-sync
ExecStop=/usr/bin/docker stop slip-sync

[Install]
WantedBy=multi-user.target
